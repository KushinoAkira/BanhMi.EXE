[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.02, 0.02, 0.04, 0.8)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.4, 0.8, 1, 1)
border_blend = true
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
shadow_color = Color(0.4, 0.8, 1, 0.6)
shadow_size = 15

[sub_resource type="Shader" id="Shader_Background"]
code = "shader_type canvas_item;

uniform vec4 bg_color : source_color = vec4(0.05, 0.05, 0.08, 1.0);
uniform vec4 grid_color : source_color = vec4(0.2, 0.2, 0.4, 0.5);
uniform float speed : hint_range(0.1, 5.0) = 0.5;
uniform float line_thickness : hint_range(0.01, 0.1) = 0.02;

void fragment() {
    vec2 uv = UV;
    uv.y += TIME * speed * 0.1; 
    vec2 grid_uv = fract(uv * 10.0);
    vec2 dist = min(grid_uv, 1.0 - grid_uv);
    float edge = min(dist.x, dist.y);
    float line_weight = smoothstep(line_thickness, line_thickness * 0.5, edge);
    float pulse = (sin(TIME * 2.0) * 0.5 + 0.5) * 0.5 + 0.5;
    vec4 final_color = mix(bg_color, grid_color * pulse, line_weight);
    COLOR = final_color;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_Background"]
shader = SubResource("Shader_Background")
shader_parameter/bg_color = Color(0.02, 0.02, 0.05, 1)
shader_parameter/grid_color = Color(0.3, 0.1, 0.5, 0.3)
shader_parameter/speed = 0.8
shader_parameter/line_thickness = 0.03

