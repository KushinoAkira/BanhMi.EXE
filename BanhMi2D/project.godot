; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Bánh Mì .EXE"
config/description="Idle Tycoon 2.5D Isometric - Bán bánh mì cùng cựu nhân viên IT"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "C#")

[autoload]

GameManager="*res://scripts/game_manager.gd"
SettingsManager="*res://scripts/settings_manager.gd"
SettingsUI="*res://scenes/settings_ui.tscn"
PopupManager="*res://scripts/popup_manager.gd"
CartManager="*res://scripts/cart_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="BanhMiExe"

[input]

ui_accept={
"deadzone": 0.5,
"events": []
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
